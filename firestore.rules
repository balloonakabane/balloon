rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/settings/profile {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/entries/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
